# GitHub storage (a PRIVATE repo that holds the data)
GITHUB_TOKEN=            # fine-grained token: this repo only, Contents: Read and write
GITHUB_REPO=             # e.g. brightmoyo/sacred-falls-data
GITHUB_BRANCH=main
# Frontend address allowed to call this API (comma separated)
ALLOWED_ORIGIN=https://your-site.vercel.app
# Optional: also email Sara each booking (resend.com)
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=Sacred Falls <onboarding@resend.dev>

# Admin dashboard login (choose a long passphrase)
ADMIN_PASSWORD=
